SHEET_KEY=1SgG5bFTMo3uRGDDV7O1dE6bYelxdvMwMgWS4wzddKKU

# Apps Script /exec URL — used server-side and (as NEXT_PUBLIC_...) client-side
# to build the URL that gets encoded into each QR code. Not a secret — it's
# literally what's printed under every physical QR code anyway.
SCRIPT_URL=https://script.google.com/macros/s/AKfycbxa1vsvgsCYee-WhnElePIjeA8fjmNoXQBnZL7hlIqyTNsaDOTcjWsmnsuAQtp8RfBxTg/exec
NEXT_PUBLIC_SCRIPT_URL=https://script.google.com/macros/s/AKfycbxa1vsvgsCYee-WhnElePIjeA8fjmNoXQBnZL7hlIqyTNsaDOTcjWsmnsuAQtp8RfBxTg/exec

# Re-use the SAME service account you already created for the Sheet — do not
# make a new one. Open its downloaded JSON key file and copy these two
# fields out of it:
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the private_key value exactly as it appears in the JSON file,
# including the literal \n sequences (do NOT turn them into real line
# breaks) — the code converts them back at runtime.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentHere\n-----END PRIVATE KEY-----\n"
